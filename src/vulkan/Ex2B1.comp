#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer
{
    uint values[];
} inputBuffer;

layout(set = 0, binding = 1, std430) readonly buffer IndexBuffer
{
    uint values[];
} indexBuffer;

layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer
{
    uint values[];
} outputBuffer;

layout(push_constant) uniform Parameters
{
    uint elementCount;
} parameters;

void main()
{
    const uint index = gl_GlobalInvocationID.x;
    if (index >= parameters.elementCount)
    {
        return;
    }

    const uint selected = indexBuffer.values[index];
    outputBuffer.values[index] =
        inputBuffer.values[selected] ^ (0x9E3779B9U + index);
}
