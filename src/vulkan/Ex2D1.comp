#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer PreviousBuffer
{
    uint previous[];
};

layout(set = 0, binding = 1, std430) writeonly buffer NextBuffer
{
    uint nextState[];
};

layout(push_constant) uniform PushConstants
{
    uint elementCount;
    uint pass;
} parameters;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= parameters.elementCount)
        return;

    uint v = previous[i] ^ (0x9E3779B9u + i + parameters.pass);
    uint r = (v << 5u) | (v >> 27u);
    nextState[i] = r + 0x7F4A7C15u;
}
